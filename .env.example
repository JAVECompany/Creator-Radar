# Local development. Change the local PostgreSQL password before starting Compose.
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar
POSTGRES_PORT=5432
DATABASE_URL=
APP_URL=http://localhost:3000
# Independent random secrets. SESSION_SECRET >=32 characters. TOKEN_ENCRYPTION_KEY = 32 bytes base64.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional official providers
YOUTUBE_API_KEY=
IG_DISCOVERY_TOKEN=
IG_DISCOVERY_ACCOUNT_ID=
META_GRAPH_VERSION=
# Managed, published Facebook Page
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Threads user token. Public profile lookup additionally requires threads_profile_discovery.
THREADS_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta App Secret for webhook signatures if it differs from the Instagram app secret.
META_WEBHOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# disabled or openai. Use metadata only after checking source permissions.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
